# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PEP 8 and the existing cad/ sources use four spaces; ruff assumes the same.
[*.py]
indent_size = 4

# Trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
